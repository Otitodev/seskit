# Text files are stored in the repository with LF endings, always.
#
# Without this, editing a file with a tool that writes the platform's native
# line ending - Python's open() in text mode on Windows does exactly that -
# rewrites every line of the file as far as git is concerned. A one-word change
# then arrives as a 500-line diff that hides what actually changed, and two
# people on different platforms can each "change" a file by opening it.
#
# eol=lf rather than a bare `text=auto`: auto normalises on commit but checks
# out CRLF on Windows, which puts the problem back for the next tool that reads
# and rewrites a file.

* text=auto eol=lf

# Binary and generated files that must not be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Vendored, and large enough that a normalisation pass would bury real changes.
apps/api/src/seskit_api/static/js/htmx.min.js -text

