# SESKit configuration
#
# Copy to .env and adjust:  cp .env.example .env
# The defaults below work as-is with `docker compose up`.

# ---------------------------------------------------------------- General ---

PROJECT_NAME=SESKit

# local | staging | production
# Outside "local", SESKit refuses to boot with placeholder secrets.
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Signs sessions and webhook payloads. Generate a real one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme

# ------------------------------------------------------------ Persistence ---

# Host names resolve on the Compose network. Running the app outside Docker?
# Replace "db" and "redis" with "localhost".
DATABASE_URL=postgresql+asyncpg://seskit:seskit@db:5432/seskit
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=seskit
POSTGRES_PASSWORD=seskit
POSTGRES_DB=seskit

# Host ports for the Compose services. High and SESKit-specific on purpose: a
# machine with PostgreSQL installed often already has clusters on 5432 AND
# 5433, and those bind before Docker - the container then looks healthy while
# every connection from your machine quietly reaches the wrong database.
# Only affects access from your machine; inside Compose it is always 5432/6379.
#
# Connecting with psql or a GUI client:
#   psql -h localhost -p 55432 -U seskit seskit
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# ------------------------------------------------- Local email (Mailpit) ---
#
# Local development sends through Mailpit instead of Amazon SES, so no AWS
# account is needed to run SESKit. Captured mail: http://localhost:8025
#
# Once an AWS connection is configured and a domain verified, sending for that
# project switches to SES automatically - no application change required.

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@seskit.local

# ------------------------------------------------------------------- AWS ---
#
# Not used until Phase 4. SESKit resolves AWS credentials the standard boto3
# way - IAM role, environment variables, credential file, or workload identity.
# Never commit real credentials.
#
# AWS_REGION=us-east-1
