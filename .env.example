# SESKit configuration
#
# Copy to .env and adjust:  cp .env.example .env
# The defaults below work as-is with `docker compose up`.

# ---------------------------------------------------------------- General ---

PROJECT_NAME=SESKit

# local | staging | production
# Outside "local", SESKit refuses to boot with placeholder secrets.
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Signs sessions and webhook payloads. Generate a real one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme

# ------------------------------------------------------------ Persistence ---

# Host names resolve on the Compose network. Running the app outside Docker?
# Replace "db" and "redis" with "localhost".
DATABASE_URL=postgresql+asyncpg://seskit:seskit@db:5432/seskit
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=seskit
POSTGRES_PASSWORD=seskit
POSTGRES_DB=seskit

# Host ports for the Compose services. High and SESKit-specific on purpose: a
# machine with PostgreSQL installed often already has clusters on 5432 AND
# 5433, and those bind before Docker - the container then looks healthy while
# every connection from your machine quietly reaches the wrong database.
# Only affects access from your machine; inside Compose it is always 5432/6379.
#
# Connecting with psql or a GUI client:
#   psql -h localhost -p 55432 -U seskit seskit
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# ------------------------------------------------- Local email (Mailpit) ---
#
# Local development sends through Mailpit instead of Amazon SES, so no AWS
# account is needed to run SESKit. Captured mail: http://localhost:8025
#
# Once an AWS connection is configured and a domain verified, sending for that
# project switches to SES automatically - no application change required.

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@seskit.local

# ------------------------------------------------------------------- AWS ---
#
# SESKit resolves AWS credentials the standard boto3 way - IAM role, environment
# variables, credential file, or workload identity - and never stores them. That
# is why there is no AWS_ACCESS_KEY_ID here: if you authenticate with keys, set
# them in the environment where boto3 will find them, not as SESKit config.
#
# Never commit real credentials.
#
# The minimum IAM policy is sts:GetCallerIdentity and ses:GetAccount. See the
# "Connecting AWS" section of README.md. Never AdministratorAccess.
#
# Pre-selects the region in the connect form. The region actually in use is
# stored per project, so this is only a default. boto3 reads this same variable
# for its own default region, which is intentional - one value, no disagreement.

AWS_DEFAULT_REGION=us-east-1

# How long SESKit waits before asking AWS about the account again. The AWS page
# reads its stored answer; Refresh forces a new check, at most this often.

AWS_STATUS_CACHE_TTL_SECONDS=300

# --- Delivery events (§15) --------------------------------------------------
# How SESKit learns what happened to a message after SES accepted it.
#
#   sqs    the worker polls an SQS queue (default; works behind NAT)
#   https  SNS posts to /v1/events/ses  (needs PUBLIC_BASE_URL and a certificate)
#   both   during a migration between the two
EVENT_INGESTION=sqs

# Names the SQS queue and SNS topic SESKit creates. Change it if one AWS account
# hosts more than one SESKit instance, and change the ARNs in the IAM policy to
# match. Changing it after setup orphans the previous resources: teardown removes
# what was recorded, not what this setting currently names.
EVENT_RESOURCE_PREFIX=seskit

# The SES configuration set sends go through. Without one SES publishes no events
# at all.
EVENT_CONFIGURATION_SET=seskit

# Where SNS can reach this instance, for EVENT_INGESTION=https. No default: a
# guessed URL produces a subscription that never confirms, which looks exactly
# like events not working.
# PUBLIC_BASE_URL=https://mail.example.com
