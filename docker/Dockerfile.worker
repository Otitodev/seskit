# Identical to docker/Dockerfile except for the final CMD. Docker builds
# don't let a platform override CMD per deployment without a compose-style
# `command:` field, and Aeroplane's Dockerfile-build path deliberately does
# not offer that override (it treats the Dockerfile as the sole source of
# truth for how the image starts) — so the worker gets its own Dockerfile
# rather than a shared one plus a runtime flag. Keep any change here mirrored
# in docker/Dockerfile and vice versa.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app


# ---------------------------------------------------------------- builder ---
FROM base AS builder

# Manifests first: this layer is cached until a dependency actually changes,
# so day-to-day source edits skip dependency resolution entirely.
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/
COPY packages/provider-aws-ses/pyproject.toml packages/provider-aws-ses/
COPY packages/provider-smtp/pyproject.toml packages/provider-smtp/
COPY packages/sdk-python/pyproject.toml packages/sdk-python/
COPY apps/api/pyproject.toml apps/api/
COPY apps/worker/pyproject.toml apps/worker/

# Workspace members must exist for the build backend to resolve them, even
# though their real sources arrive in the next step.
RUN mkdir -p packages/core/src/seskit_core \
             packages/provider-aws-ses/src/seskit_provider_aws_ses \
             packages/provider-smtp/src/seskit_provider_smtp \
             packages/sdk-python/src/seskit \
             apps/api/src/seskit_api \
             apps/worker/src/seskit_worker \
    && touch packages/core/src/seskit_core/__init__.py \
             packages/provider-aws-ses/src/seskit_provider_aws_ses/__init__.py \
             packages/provider-smtp/src/seskit_provider_smtp/__init__.py \
             packages/sdk-python/src/seskit/__init__.py \
             apps/api/src/seskit_api/__init__.py \
             apps/worker/src/seskit_worker/__init__.py

# No cache mount here, deliberately. `RUN --mount=type=cache` is BuildKit-only,
# and a builder without BuildKit does not ignore it - it fails the build with
# "the --mount option requires BuildKit". Some deployment platforms build with
# the classic builder and offer no way to turn BuildKit on, so this file has to
# be buildable by both.
#
# What that costs is wheel reuse when this layer is invalidated. Layer caching
# still covers the common case: the manifests are copied above on their own, so
# an ordinary source edit never reaches this line.
RUN uv sync --frozen --no-dev

COPY . .

# Reinstall so the workspace packages carry their real sources, not the stubs.
# Workspace members install editable, so the Compose bind mounts over /app/apps
# and /app/packages feed straight into the running process and --reload works.
# A production image should add --no-editable here to stay self-contained.
# No cache mount, for the reason given above.
RUN uv sync --frozen --no-dev


# ------------------------------------------------------------------ final ---
FROM base AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 seskit

COPY --from=builder --chown=seskit:seskit /app /app

USER seskit

CMD ["arq", "seskit_worker.main.WorkerSettings"]
