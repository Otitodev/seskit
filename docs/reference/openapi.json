          "name": {
            "examples": [
              "abc123._domainkey.example.com"
            ],
            "title": "Name",
            "type": "string"
          },
          "record_type": {
            "examples": [
              "CNAME"
            ],
            "title": "Record Type",
            "type": "string"
          },
          "value": {
            "examples": [
